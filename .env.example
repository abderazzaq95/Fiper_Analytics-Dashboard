SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WA_VERIFY_TOKEN=
MAQSAM_ACCESS_KEY=
MAQSAM_ACCESS_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
RESEND_API_KEY=
EMAIL_FROM=Fiper Alerts <onboarding@resend.dev>
SALES_SUPERVISOR_EMAIL=
AGENT_EMAIL_JEHAD_QASIM=
EMAIL_DEBUG_TOKEN=

# ── Reply reminders (pipeline/reminders.py) ──────────────────────────────────
# off | shadow | live. shadow = track + preview only, agents receive nothing.
REMINDER_MODE=shadow
# Where escalations (and shadow previews) go. Comma-separated.
REMINDER_ESCALATION_EMAILS=
# Optional: Telegram chat / WhatsApp number for escalations in live mode
# (Telegram defaults to TELEGRAM_ADMIN_CHAT_ID).
REMINDER_ESCALATION_TELEGRAM_CHAT_ID=
REMINDER_ESCALATION_WHATSAPP=
# Working schedule (timezone defaults to REPORT_TIMEZONE).
REMINDER_WORK_DAYS=mon-fri
REMINDER_WORK_START_HOUR=9
REMINDER_WORK_END_HOUR=19
# Ladder, in working minutes.
REMINDER_FIRST_MIN=15
REMINDER_SECOND_MIN=45
REMINDER_ESCALATE_MIN=120
REMINDER_FOLLOWUP_HOURS=24,72
# After this much working time (one working day) a wait gets no new pings or
# escalations; it goes into the agent's morning list and the reports instead.
REMINDER_AGENT_MAX_WORKING_HOURS=10
# One list per agent per working morning with older waits ("off" disables).
REMINDER_MORNING_LIST_TIME=09:15
# Waits are closed as expired after this many calendar hours.
REMINDER_TRACK_MAX_AGE_HOURS=168
REMINDER_AGENT_MAX_PER_HOUR=6
# AI check (Gemini, free tier is enough): does the customer need a reply, how urgent?
# off | shadow (decide + show on the dashboard, change nothing) | live (apply).
# Needs migrations/003_reply_priority.sql. Without a key the word rules are used,
# and they never skip a reminder.
REMINDER_AI_MODE=live
GEMINI_API_KEY=
REMINDER_AI_MODEL=gemini-2.5-flash-lite
REMINDER_AI_MAX_PER_CYCLE=8
REMINDER_AI_DAILY_LIMIT=500
# Priority ladders (live AI only): urgent first,second,escalate; low = one reminder.
REMINDER_URGENT_MINUTES=5,20,60
REMINDER_LOW_FIRST_MIN=30

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_USER=fiper
DASHBOARD_PASSWORD=
# Teams come from Maqsam /v1/agents (MAQSAM_ACCESS_KEY/SECRET, or set
# MAQSAM_API_USERNAME/PASSWORD). Optional manual list instead:
# AGENT_TEAMS_JSON={"Team name":["Agent name"]}
